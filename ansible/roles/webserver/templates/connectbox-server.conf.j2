# {{ ansible_managed }}
# chat.{{ url }} -> chathost (2820), bolt.{{ url }} -> MediaBuilder (3000)

server_names_hash_bucket_size 128;
client_max_body_size 1000M;

{% if tls_enabled | bool %}
# Plain HTTP: Let's Encrypt renewals, everything else redirects to HTTPS.
server {
	listen {{ http_port }};
	listen [::]:{{ http_port }};
	server_name chat.{{ url }} bolt.{{ url }};

	location /.well-known/acme-challenge/ {
		root /var/www/letsencrypt;
	}

	location / {
		return 301 https://$host$request_uri;
	}
}
{% endif %}

{% for site in [{'name': 'chat', 'port': 2820}, {'name': 'bolt', 'port': 3000}] %}
server {
{% if tls_enabled | bool %}
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	ssl_certificate     /etc/letsencrypt/live/{{ url }}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/{{ url }}/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
{% else %}
	listen {{ http_port }};
	listen [::]:{{ http_port }};

	location /.well-known/acme-challenge/ {
		root /var/www/letsencrypt;
	}
{% endif %}
	server_name {{ site.name }}.{{ url }};

	location / {
{% if site.name == 'bolt' %}
		# Exports are fetched by boxes and the media interface from anywhere
		proxy_hide_header Access-Control-Allow-Origin;
		proxy_hide_header Referrer-Policy;
		add_header 'Access-Control-Allow-Origin' '*' always;
{% endif %}
		proxy_pass http://127.0.0.1:{{ site.port }};
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}
}

{% endfor %}
